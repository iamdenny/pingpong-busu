# Browser-public values only
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use VITE_SUPABASE_ANON_KEY instead.
VITE_SUPABASE_ANON_KEY=
VITE_APP_MODE=demo
VITE_APP_BASE_PATH=/pingpong-busu/
VITE_DEV_LIVE_SEARCH=false
VITE_SOURCE_REFRESH_ENABLED=false

# Trusted server/crawler values
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRAWL_LIVE=false
CRAWLER_USER_AGENT=BUSU/0.1
CRAWLER_CONTACT_EMAIL=
CRAWLER_SOURCE_AIRPING_ENABLED=false
CRAWLER_SOURCE_ASTREE_ENABLED=false
CRAWLER_SOURCE_TTADIVISION_ENABLED=false
CRAWLER_SOURCE_OKPINGPONG_ENABLED=false
CRAWLER_SOURCE_MYTT_ENABLED=false
CRAWLER_SOURCE_SUPERSTAR_ENABLED=false
CRAWLER_SOURCE_YONGINTT_ENABLED=false
CRAWLER_SOURCE_IPING_ENABLED=false
CRAWLER_SOURCE_BAND_ENABLED=false
CRAWLER_REQUEST_TIMEOUT_MS=8000
CRAWLER_MAX_CONCURRENCY=2
CRAWLER_COOLDOWN_SECONDS=3600
CRAWLER_SOURCE_MIN_INTERVAL_MS=2000
KAKAO_REST_API_KEY=
IPING_USERNAME=
IPING_PASSWORD=

# Deployment credentials (never exposed to the browser)
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
# Optional: only needed for direct password-based database access.
SUPABASE_DB_PASSWORD=
